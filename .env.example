# ==============================================================================
# Tarsier Local Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' before running Docker Compose:
#   cp .env.example .env
#
# DO NOT commit your actual '.env' file containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Networking
# ------------------------------------------------------------------------------
# Host port on which Tarsier web dashboard and REST API will be exposed.
TARSIER_PORT=8080

# ------------------------------------------------------------------------------
# 2. Authentication & Admin Credentials
# ------------------------------------------------------------------------------
# Initial administrator username (default: admin).
TARSIER_ADMIN_USER=admin

# Bcrypt password hash for the initial admin account.
# Minimum cost factor: 10 (recommended: 12).
#
# The default hash below corresponds to password: "admin"
# Note: Wrap in single quotes in .env so Docker Compose does not interpolate '$' as a variable.
#
# To generate your own bcrypt hash:
#   htpasswd -nbBC 12 "" "your-strong-password" | tr -d ':\n'
TARSIER_ADMIN_PASSWORD_HASH='$2a$12$ynZsf5yrFkCAE3V2kOMY6uPVgENIRXSBRxAVF9H8Jb0pKy4j.mztW'

# Cryptographic secret for signing HMAC-SHA256 session cookies (min 32 bytes).
# If unset, Tarsier will generate an ephemeral secret on each startup,
# which invalidates active browser sessions across container restarts.
TARSIER_SESSION_SECRET=local-dev-session-secret-must-be-at-least-32-bytes-long

# ------------------------------------------------------------------------------
# 3. Configuration & Storage Paths
# ------------------------------------------------------------------------------
# Path to Tarsier YAML configuration file inside the container.
TARSIER_CONFIG=/config/tarsier.yaml

# Local configuration file path on your host machine mounted into /config/tarsier.yaml.
# For local testing, defaults to ./tarsier.yaml.
TARSIER_CONFIG_FILE=./tarsier.yaml

# ------------------------------------------------------------------------------
# 4. Go Runtime Limits
# ------------------------------------------------------------------------------
# Soft memory limit for the Go runtime garbage collector (Tarsier target: < 256 MB RAM).
# Keeps memory well under the container cgroup ceiling.
GOMEMLIMIT=200MiB

# ------------------------------------------------------------------------------
# 5. Host Telemetry Paths
# ------------------------------------------------------------------------------
# Default paths for macOS Docker Desktop / standard container telemetry:
HOST_PROC=/proc
HOST_SYS=/sys
HOST_ROOT=/

# For bare-metal Linux hosts with host mounts enabled in docker-compose.yml:
# HOST_PROC=/host/proc
# HOST_SYS=/host/sys
# HOST_ROOT=/host/root

# ------------------------------------------------------------------------------
# 6. Outbound Notification Channels & Integrations
# ------------------------------------------------------------------------------
# --- Full SMTP Email Notifier Configuration ---
# Set to 'true' to enable outbound email alerts and pre-cleanup digest reports
SMTP_ENABLED=false
# Outbound SMTP server hostname or IP address (e.g. smtp.gmail.com, smtp.mailgun.org)
SMTP_HOST=smtp.example.com
# Outbound SMTP port (587 for STARTTLS, 465 for TLS, 25 for plaintext)
SMTP_PORT=587
# Transport security mechanism: starttls | tls | none
SMTP_SECURITY=starttls
# SMTP authentication username
SMTP_USER=alerts@example.com
# SMTP authentication password
SMTP_PASSWORD=
# RFC 5322 formatted sender address (e.g. "Tarsier Alerts <alerts@example.com>")
SMTP_FROM=Tarsier <alerts@example.com>
# Comma-separated or single recipient email address for alerts
SMTP_TO=admin@example.com

# --- Discord Webhook Notifier ---
# Discord incoming webhook URL for alert notifications and daily pre-cleanup digest reports.
# Example: https://discord.com/api/webhooks/123456789/abcdefghij
DISCORD_WEBHOOK_URL=

# --- Heartbeat Health Check ---
# Outgoing heartbeat ping URL (e.g. Healthchecks.io, Uptime Kuma, Cronitor).
# Example: https://hc-ping.com/your-uuid-here
HEARTBEAT_URL=
